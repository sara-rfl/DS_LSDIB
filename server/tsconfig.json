{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    "rootDir": "./",
    "outDir": "./dist",

    "target": "ES6",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    // Environment Settings
    // "types": ["node"], // Uncomment if needed
    // "lib": ["esnext"], // Uncomment if needed
    // "types": ["node"], // Uncomment if needed
    // and npm install -D @types/node

    // Other Outputs
    // "sourceMap": true, // Uncomment if needed
    // "declaration": true, // Uncomment if needed
    // "declarationMap": true, // Uncomment if needed

    // Stricter Typechecking Options
    // "noUncheckedIndexedAccess": true, // Uncomment if needed
    // "exactOptionalPropertyTypes": true, // Uncomment if needed

    // Style Options
    // "noImplicitReturns": true, // Uncomment if needed
    // "noImplicitOverride": true, // Uncomment if needed
    // "noUnusedLocals": true, // Uncomment if needed
    // "noUnusedParameters": true, // Uncomment if needed
    // "noFallthroughCasesInSwitch": true, // Uncomment if needed
    // "noPropertyAccessFromIndexSignature": true, // Uncomment if needed

    // Recommended Options
    "jsx": "react-jsx", // Uncomment if needed
    "verbatimModuleSyntax": false, // Uncomment if needed
    "isolatedModules": true, // Uncomment if needed
    "noUncheckedSideEffectImports": true, // Uncomment if needed
     "moduleDetection": "force", // Uncomment if needed
  },

  "include": ["./**/*.ts"],
  "exclude": ["./dist"]
}